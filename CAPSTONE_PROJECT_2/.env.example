# ==============================================================================
# TourPulse: Cloud-Based Tourist Flow and Attraction Analytics
# Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL CREDENTIALS
# DO NOT COMMIT .env TO VERSION CONTROL
# ==============================================================================

# Application Environment
APP_ENV=development
SECRET_KEY=tourpulse-capstone-jwt-secret-key-production-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Oracle Database Configuration (Managed via Oracle SQL Developer)
# Recommended: Run database/oracle_schema.sql under user TOURPULSE
ORACLE_USER=TOURPULSE
ORACLE_PASSWORD=your_password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XE

# Optional: Google Cloud Platform (GCP) Configuration
# Leave as placeholders unless connecting to live Google Cloud services
GCP_PROJECT_ID=tourpulse-capstone-gcp
GCP_STORAGE_BUCKET=tourpulse-raw-telemetry
GCP_BIGQUERY_DATASET=tourist_analytics
GCP_DATAPROC_CLUSTER=tourpulse-dataproc-cluster
GCP_REGION=us-central1
GCP_CREDENTIALS_PATH=
